{
  "name": "@khr3/c12",
  "version": "0.3.10",
  "description": "Exact cyclotomic Z[1/2, sqrt(3)] yaw12 lattice math, 3 m socket snapping, road-aware settlement generators (village to ginormous city) and InstancedMesh batches for khr3.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "khr3",
    "c12",
    "yaw12",
    "cyclotomic",
    "lattice",
    "building",
    "sockets",
    "threejs",
    "r3f",
    "gamedev"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkAphant/khr3-c12.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --rootDir . --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022 --types node --strict --verbatimModuleSyntax --skipLibCheck example/index.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"for(const f of fs.readdirSync('dist'))if(f.includes('.test.'))fs.rmSync('dist/'+f)\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "example": "tsx example/index.ts",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
